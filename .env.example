# ========================================
# UNBREAK ONE - Environment Variables Template
# ========================================
# Copy to .env.local and fill with YOUR values
# NEVER commit .env.local to git!

# ========================================
# 📦 DATABASE - Supabase PostgreSQL
# ========================================
# Get from: Supabase Dashboard → Settings → API

# Server-side Database URLs (used in Prisma/API routes)
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxx:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxxx:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.co:5432/postgres

# Server-side Supabase Client
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_service_role_key

# Client-side Public Keys (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_anon_key

# ========================================
# 💳 STRIPE PAYMENT PROCESSING
# ========================================
# Get from: Stripe Dashboard → Developers → API Keys

# ⚠️ IMPORTANT: Use TEST keys locally, LIVE keys only in Vercel Production!

# Test Mode Keys (for local development & preview)
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Live Mode Keys (VERCEL PRODUCTION ONLY - do NOT use locally!)
# STRIPE_SECRET_KEY=sk_live_your_live_secret_key_here
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key_here
# STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret_here

# ========================================
# 🔐 AUTHENTICATION - NextAuth
# ========================================
# Generate secret: openssl rand -base64 32

NEXTAUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXTAUTH_URL=http://localhost:3000
# Production (Vercel): NEXTAUTH_URL=https://www.unbreak-one.com

# ========================================
# 📧 EMAIL SERVICE - Resend
# ========================================
# Get from: Resend Dashboard → API Keys

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAILS_ENABLED=true

# Verified Sender Addresses (must be verified in Resend Dashboard)
RESEND_FROM=UNBREAK ONE <noreply@unbreak-one.de>
SHOP_OWNER_EMAIL=shop@unbreak-one.de

# ========================================
# 👤 ADMIN PANEL
# ========================================

# Server-only secrets. NEVER prefix secrets with NEXT_PUBLIC_ (shipped to every browser).
# Admin UI authenticates via NextAuth session; no API key in the browser.
ADMIN_API_KEY=<generate-with: openssl rand -base64 32>

# Optional: Stripe test mode on a checkout (header x-admin-test-key).
# On production only if CHECKOUT_ADMIN_TEST_ENABLED=true (default off).
ADMIN_TEST_KEY=
CHECKOUT_ADMIN_TEST_ENABLED=false

# Optional: /api/admin/bootstrap (disabled on production unless BOOTSTRAP_ENABLED=true)
BOOTSTRAP_SECRET=
BOOTSTRAP_ENABLED=false

# Optional: /api/email/test outside development
EMAIL_TEST_SECRET=

# Initial Admin User (only used by setup/seed scripts)
ADMIN_SEED_EMAIL=admin@unbreak-one.com
ADMIN_SEED_PASSWORD=<min. 16 chars, only in .env.local>

# ========================================
# 🎛️ FEATURE FLAGS & CONFIG
# ========================================

# Debug Mode (shows detailed logs, config inspector)
NEXT_PUBLIC_DEBUG=false

# Checkout Kill-Switch (emergency disable)
CHECKOUT_ENABLED=true

# Node Environment (usually auto-set)
NODE_ENV=development

# ========================================
# 🌐 EXTERNAL SERVICES
# ========================================

# 3D Configurator (external Vercel app)
NEXT_PUBLIC_CONFIGURATOR_DOMAIN=https://unbreak-3-d-konfigurator.vercel.app

# Main Site URL (used for redirects, canonical URLs, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: https://www.unbreak-one.com

# ========================================
# 🚀 VERCEL-SPECIFIC (auto-injected, DO NOT SET LOCALLY)
# ========================================
# VERCEL=1
# VERCEL_ENV=production|preview|development
# VERCEL_URL=xxx.vercel.app
# VERCEL_GIT_COMMIT_SHA=abc123def
# VERCEL_GIT_COMMIT_REF=main
# VERCEL_OIDC_TOKEN=eyJhbGci...
# etc.

# ========================================
# 🔧 OPTIONAL / ADVANCED
# ========================================

# Turbo Build Cache (Vercel CI/CD only)
# TURBO_CACHE=remote:rw
# TURBO_DOWNLOAD_LOCAL_ENABLED=true

# NX Monorepo (not used)
# NX_DAEMON=false

# ========================================
# 📋 VERCEL ENVIRONMENT SETUP GUIDE
# ========================================
#
# PRODUCTION Environment Variables (Vercel Dashboard):
# ✅ STRIPE_SECRET_KEY = sk_live_... (LIVE MODE!)
# ✅ NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY = pk_live_... (LIVE MODE!)
# ✅ STRIPE_WEBHOOK_SECRET = whsec_... (from Stripe webhook config)
# ✅ NEXTAUTH_URL = https://www.unbreak-one.com
# ✅ NEXT_PUBLIC_SITE_URL = https://www.unbreak-one.com
# ✅ All database credentials (same as local)
# ✅ RESEND_API_KEY = re_...
# ✅ EMAILS_ENABLED = true
#
# PREVIEW Environment Variables:
# ✅ Same as Production BUT use TEST Stripe keys (sk_test_...)
# ✅ EMAILS_ENABLED = false (optional, to prevent test emails)
#
# DEVELOPMENT Environment Variables:
# ✅ Same as Preview (TEST Stripe keys)
#
# ========================================
# 🔒 SECURITY CHECKLIST
# ========================================
#
# ✅ .env.local is in .gitignore
# ✅ Never commit real keys to git
# ✅ SUPABASE_SERVICE_ROLE_KEY only server-side (never NEXT_PUBLIC_)
# ✅ Separate TEST/LIVE Stripe keys per environment
# ✅ Rotate NEXTAUTH_SECRET if exposed
# ✅ Admin password changed from default
# ✅ Webhook secrets match Stripe dashboard config
#
# ========================================
